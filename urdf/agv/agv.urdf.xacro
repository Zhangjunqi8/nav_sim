<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="agv">
  <!--
    Planar omnidirectional navigation AGV for nav_sim.
    Stack-agnostic: publishes /scan, /odom, TF. Swap in your own URDF here
    without touching anything else in this package.
  -->
  <!-- Body shrunk to 40 x 30 cm (from 60 x 50). Height and wheel radius stay
       so the spawn height / wheel-ground contact geometry does not change. -->
  <xacro:property name="base_length" value="0.40"/>
  <xacro:property name="base_width"  value="0.30"/>
  <xacro:property name="base_height" value="0.25"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheelbase" value="0.32"/>
  <xacro:property name="track_width" value="0.26"/>

  <!-- base_footprint: standard Nav2 footprint frame (odom -> base_footprint -> base_link) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- base_link -->
  <link name="base_link">
    <inertial>
      <mass value="12.0"/>
      <inertia ixx="0.10" ixy="0.0" ixz="0.0" iyy="0.12" iyz="0.0" izz="0.15"/>
      <origin xyz="0 0 0.05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
      <material name="grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
    </collision>
  </link>

  <!-- Fixed wheel geometry: planar_drive_plugin controls the rigid chassis. -->
  <xacro:macro name="mecanum_wheel" params="prefix x y">
    <link name="${prefix}_wheel">
      <inertial>
        <mass value="0.4"/>
        <inertia ixx="0.0003" ixy="0.0" ixz="0.0" iyy="0.0003" iyz="0.0" izz="0.0006"/>
        <origin xyz="0 0 0"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${3.1415926/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${3.1415926/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
    </link>
    <joint name="${prefix}_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${x} ${y} -${wheel_radius}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${prefix}_wheel">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:mecanum_wheel prefix="front_left"  x="${ wheelbase/2}" y="${ track_width/2}"/>
  <xacro:mecanum_wheel prefix="front_right" x="${ wheelbase/2}" y="${-track_width/2}"/>
  <xacro:mecanum_wheel prefix="rear_left"   x="${-wheelbase/2}" y="${ track_width/2}"/>
  <xacro:mecanum_wheel prefix="rear_right"  x="${-wheelbase/2}" y="${-track_width/2}"/>

  <!-- caster (passive ball) -->
  <link name="caster_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><sphere radius="0.03"/></geometry>
    </collision>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="-${base_length/2 - 0.05} 0 -${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- 2D lidar on top -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
      <material name="blue"><color rgba="0.2 0.2 0.9 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.05"/></geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 ${base_height + 0.05}" rpy="0 0 0"/>
  </joint>

  <!-- RGB-D camera (front) -->
  <link name="camera_link"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${base_length/2 - 0.02} 0 ${base_height}" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo plugins: planar drive, lidar, camera -->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
    <gravity>true</gravity>
  </gazebo>

  <gazebo reference="caster_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <gazebo>
    <plugin name="planar_drive" filename="libplanar_drive_plugin.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <cmd_vel_timeout>0.5</cmd_vel_timeout>
      <publish_rate>50.0</publish_rate>
    </plugin>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar_2d">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10.0</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="lidar_2d_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>/lidar_2d_plugin/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor type="depth" name="camera_depth">
      <update_rate>5.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>20.0</far></clip>
      </camera>
      <plugin name="camera_depth_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/depth/image_raw</remapping>
          <remapping>camera_info:=/camera/depth/camera_info</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_color">
      <update_rate>5.0</update_rate>
      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>20.0</far></clip>
      </camera>
      <plugin name="camera_color_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <remapping>image_raw:=/camera/color/image_raw</remapping>
          <remapping>camera_info:=/camera/color/camera_info</remapping>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Aligned depth camera removed: the detector reads /camera_depth/depth/image_raw
       directly (aligned_depth_image_topic points at the depth image), so this third
       camera only doubled the software-rendering cost. Restore if a color-aligned
       depth stream is ever needed. -->
</robot>
